# ===========================================
# LINKEDIN PIPELINE MIGRATION FEATURE FLAGS
# ===========================================

# Enable direct LinkedIn pipeline (bypasses linkedin-profile-reducer)
# Set to 'true' to use direct pipeline, 'false' for legacy pipeline
BYPASS_LINKEDIN_REDUCER=false

# Gradual rollout percentage (0-100)
# Controls what percentage of requests use the direct pipeline
# Example: 25 = 25% of requests use direct pipeline, 75% use legacy
LINKEDIN_PIPELINE_ROLLOUT_PERCENTAGE=0

# Enable pipeline comparison for testing/validation
# Runs both pipelines in parallel and logs comparison results
ENABLE_PIPELINE_COMPARISON=false

# Verbose logging for pipeline debugging
# Logs detailed information about pipeline execution
VERBOSE_LINKEDIN_LOGGING=false

# ===========================================
# MIGRATION PHASES GUIDE
# ===========================================
# Phase 1 (Development): ENABLE_PIPELINE_COMPARISON=true, VERBOSE_LINKEDIN_LOGGING=true
# Phase 2 (Testing): LINKEDIN_PIPELINE_ROLLOUT_PERCENTAGE=10
# Phase 3 (Gradual Rollout): LINKEDIN_PIPELINE_ROLLOUT_PERCENTAGE=25,50,75
# Phase 4 (Full Migration): BYPASS_LINKEDIN_REDUCER=true